clc;
clear;
close all;

Fs = 10000;
Fp = 3000;
Fst = 2000;

% Calculate minimum filter order
[N, Wn] = buttord(Fp/(Fs/2), Fst/(Fs/2), 1, 60);

% Design Butterworth High-Pass Filter
[b, a] = butter(N, Wn, 'high');

% Magnitude and Phase Response
figure;
freqz(b, a);
title('Magnitude and Phase Response');

% Impulse Response
figure;
[h, n] = impz(b, a, 50);
stem(n, h, 'filled');
grid on;
title('Impulse Response');
xlabel('Samples');
ylabel('Amplitude');

% Step Response
figure;
stepz(b, a);
grid on;
title('Step Response');

% Group Delay
figure;
grpdelay(b, a);
grid on;
title('Group Delay');

% Pole-Zero Plot
figure;
zplane(b, a);
title('Pole-Zero Plot');

% Display filter parameters
fprintf('Minimum Filter Order (N) = %d\n', N);
fprintf('Cutoff Frequency (Wn) = %.4f\n', Wn);
